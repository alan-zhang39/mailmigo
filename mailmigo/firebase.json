{
  "functions": [
    {
      "source": "functions/main-ts",
      "codebase": "main-ts",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    },
    {
      "source": "functions/main-py",
      "codebase": "main-py",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "dev",
      "source": ".",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "predeploy": "npm run build --configuration=development",
      "frameworksBackend": {
        "region": "us-central1"
      }
    },
    {
      "target": "prod",
      "source": ".",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "predeploy": "npm run build --configuration=production",
      "frameworksBackend": {
        "region": "us-central1"
      }
    }
  ]
}
