{
  "name": "functions",
  "scripts": {
    "lint": "eslint --fix --ext .js,.ts .",
    "build": "npm run sync-shared ; tsc",
    "build:watch": "npm run sync-shared ; tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "sync-shared": "npm --prefix \"../../shared\" run build ; cp -r ../../shared/ ./*shared",
    "postinstall": "node node_modules/puppeteer/install.mjs",
    "gcp-build": "node node_modules/puppeteer/install.mjs"
  },
  "engines": {
    "node": "18"
  },
  "main": "dist/src/index.js",
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.592.0",
    "@aws-sdk/client-textract": "^3.592.0",
    "@pinecone-database/pinecone": "^2.2.2",
    "*shared": "file:./*shared",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^140.0.0",
    "mailcomposer": "^4.0.2",
    "md-to-pdf": "^5.2.4",
    "nodemailer": "^6.9.14",
    "openai": "^4.49.1",
    "pdf-img-convert": "^1.2.1",
    "puppeteer": "^22.12.1"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.15",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^4.9.0"
  },
  "private": true
}
